rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function appRole() {
      return get(
        /databases/$(database)/documents/profiles/$(request.auth.uid)
      ).data.role;
    }

    function isRider() {
      return hasProfile() && appRole() == 'rider';
    }

    function isAdmin() {
      return hasProfile() && appRole() == 'admin';
    }

    function validPickupRequest() {
      return request.resource.data.keys().hasAll([
          'id',
          'wasteType',
          'description',
          'submittedAt',
          'status',
          'sackCount',
          'priceUgx',
          'isInstant',
          'zone',
          'address',
          'residentName',
          'residentPhone',
          'residentId'
        ])
        && request.resource.data.id is string
        && request.resource.data.wasteType in [
          'household',
          'tradingCenter',
          'unknown'
        ]
        && request.resource.data.description is string
        && request.resource.data.status in [
          'requested',
          'collected',
          'awaitingVerification',
          'paid',
          'cancelled'
        ]
        && request.resource.data.sackCount is int
        && request.resource.data.sackCount > 0
        && request.resource.data.priceUgx is int
        && request.resource.data.isInstant is bool
        && request.resource.data.zone in ['north', 'south', 'east', 'west']
        && request.resource.data.residentId is string;
    }

    match /profiles/{profileId} {
      allow read: if signedIn()
        && (request.auth.uid == profileId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == profileId
        && request.resource.data.id == profileId
        && request.resource.data.role == 'resident'
        && request.resource.data.keys().hasOnly([
          'id',
          'fullName',
          'email',
          'phone',
          'role',
          'createdAt',
          'updatedAt'
        ]);

      allow update: if signedIn()
        && request.auth.uid == profileId
        && request.resource.data.role == resource.data.role
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'phone', 'updatedAt']);

      allow delete: if isAdmin();
    }

    match /pickupRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.residentId == request.auth.uid || isRider() || isAdmin());

      allow create: if signedIn()
        && request.resource.data.residentId == request.auth.uid
        && request.resource.data.id == requestId
        && request.resource.data.status == 'requested'
        && validPickupRequest();

      allow update: if isAdmin()
        || (
          isRider()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
          && (
            (
              resource.data.status == 'requested'
              && request.resource.data.status == 'collected'
            )
            || (
              resource.data.status == 'collected'
              && request.resource.data.status == 'awaitingVerification'
            )
          )
        )
        || (
          signedIn()
          && resource.data.residentId == request.auth.uid
          && resource.data.status == 'requested'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
        );

      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.residentId == request.auth.uid
          && resource.data.status == 'requested'
        );
    }
  }
}
