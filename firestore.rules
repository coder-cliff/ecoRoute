rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'ayikog@yahoo.com' ||
        request.auth.token.email == 'saviordeogratius@gmail.com' ||
        request.auth.token.email == 'admin@ecoroute.ug'
      );
    }

    // Profiles collection (residents, riders, administrators)
    // Read & create are allowed publicly to support guest checkout & username resolution before sign-in
    match /profiles/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // Collection pickup requests (created by residents, accepted by riders, verified by admins)
    match /pickupRequests/{requestId} {
      allow read: if true;
      allow write: if true;
    }

    // Invited collection riders registry
    // Read & write allowed so Admin can dispatch invites and Riders can verify tokens
    match /invitedRiders/{riderEmail} {
      allow read: if true;
      allow write: if true;
    }

    // Auxiliary collections fallback
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
